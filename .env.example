# Full public URL of the site, including the sub-path on GitHub Pages
# e.g. https://<user>.github.io/lancet-architects  (or https://lancetarchitect.com on a custom domain)
NEXT_PUBLIC_SITE_URL=https://lancetarchitect.com
# Sub-path the site is served from: "/lancet-architects" on GitHub Pages, empty on a custom domain
NEXT_PUBLIC_BASE_PATH=

# Contact form (static hosting): a form service endpoint. Without it, the form opens the visitor's email app.
# Formspree: NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/<id>
# Web3Forms: NEXT_PUBLIC_FORM_ENDPOINT=https://api.web3forms.com/submit and NEXT_PUBLIC_FORM_ACCESS_KEY=<key>
NEXT_PUBLIC_FORM_ENDPOINT=
NEXT_PUBLIC_FORM_ACCESS_KEY=
